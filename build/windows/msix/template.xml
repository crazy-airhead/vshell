<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="vshell"
        Arguments=""
        InstallLocation="C:\Program Files\vShell\vShell">
    </Installer>
    <PackageInformation
        PackageName="vShell"
        PackageDisplayName="vShell"
        PublisherName="CN=vShell"
        PublisherDisplayName="vShell"
        Version="1.2.2.0"
        PackageDescription="SSH Client Management Tool">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.vshell.app"
                Description="SSH Client Management Tool"
                DisplayName="vShell"
                ExecutableName="vshell"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>vShell</DisplayName>
            <PublisherDisplayName>vShell</PublisherDisplayName>
            <Description>SSH Client Management Tool</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="vshell.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
